<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PomodoroTimeTracker.WinUI3.Views.PomodoroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PomodoroTimeTracker.WinUI3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:viewmodels="using:PomodoroTimeTracker.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:PomodoroViewModel}"
    mc:Ignorable="d">

    <Grid>
        <!--  Setup Screen  -->
        <ScrollViewer Visibility="{x:Bind ViewModel.IsSetupState, Mode=OneWay}">
            <StackPanel
                MaxWidth="600"
                Margin="24"
                HorizontalAlignment="Left"
                Spacing="24">

                <TextBlock
                    FontSize="32"
                    FontWeight="Bold"
                    Text="Start Pomodoro" />

                <Border
                    Width="400"
                    MinHeight="500"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="20">

                        <!--  Client Selection  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Client" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind ViewModel.Clients, Mode=OneWay}"
                                PlaceholderText="Select a client"
                                SelectedItem="{x:Bind ViewModel.SelectedClient, Mode=TwoWay}" />
                        </StackPanel>

                        <!--  Project Selection  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Project" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Name"
                                IsEnabled="{x:Bind ViewModel.IsClientSelected, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                                PlaceholderText="Select a project"
                                SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}" />
                        </StackPanel>

                        <!--  Objective  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Objective" />
                            <TextBox
                                Height="80"
                                AcceptsReturn="True"
                                MaxLength="{x:Bind viewmodels:PomodoroViewModel.ObjectiveMaxLength}"
                                PlaceholderText="What will you work on during this Pomodoro?"
                                Text="{x:Bind ViewModel.Objective, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Height="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ObjectiveCharacterCount, Mode=OneWay}"
                                TextAlignment="Right" />
                        </StackPanel>

                        <!--  Duration  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Duration (minutes)" />
                            <NumberBox
                                MinWidth="200"
                                HorizontalAlignment="Left"
                                LargeChange="5"
                                Maximum="120"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.DurationMinutes, Mode=TwoWay}" />
                        </StackPanel>

                        <!--  Start Button  -->
                        <Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.StartPomodoroCommand}"
                            Content="Start Pomodoro"
                            Style="{StaticResource AccentButtonStyle}" />

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  Running Timer Screen  -->
        <Grid Visibility="{x:Bind ViewModel.IsTimerActive, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Container for all timer components - aligned to left with consistent margin  -->
            <StackPanel
                Grid.Row="0"
                Width="360"
                Margin="4,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Spacing="-10">

                <!--  Session Type - centered within container  -->
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind ViewModel.SessionTypeLabel, Mode=OneWay}"
                    TextAlignment="Center" />

                <!--  Wrap Up Period Info  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsWrapUpState, Mode=OneWay}"
                    Message="Work time complete! You can continue working during this wrap up period to finish your current thought."
                    Severity="Informational"
                    Title="Wrap Up Period Active" />

                <!--  Timer with Progress Meter  -->
                <Grid x:Name="TimerGrid" Width="360" Height="400">
                    <!--  Progress Arc Background  -->
                    <Canvas
                        Width="360"
                        Height="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!--  Progress Path (Red overlay that decreases clockwise from 12 o'clock)  -->
                        <Path
                            x:Name="ProgressPath"
                            Canvas.Left="0"
                            Canvas.Top="0"
                            Data=""
                            Fill="#FFE74C3C"
                            Opacity="0.2"
                            Stretch="None" />
                    </Canvas>

                    <!--  Timer and Objective centered in circle  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                        <!--  Timer Display  -->
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="72"
                            FontWeight="Bold"
                            Text="{x:Bind ViewModel.TimerDisplay, Mode=OneWay}"
                            TextAlignment="Center" />

                        <!--  Objective Display  -->
                        <TextBlock
                            MaxWidth="300"
                            FontSize="14"
                            Text="{x:Bind ViewModel.Objective, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsNotBreakState, Mode=OneWay}" />

                        <!--  Billable Toggle during break  -->
                        <ToggleSwitch
                            HorizontalAlignment="Center"
                            IsOn="{x:Bind ViewModel.IsBreakBillable, Mode=TwoWay}"
                            OffContent="Not billable"
                            OnContent="Billable"
                            Visibility="{x:Bind ViewModel.IsBreakState, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!--  Control Buttons Container - same width and alignment as timer components  -->
            <Grid
                Grid.Row="1"
                Width="360"
                Margin="4,-10,0,24"
                HorizontalAlignment="Left">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="32">

                    <!--  Pause/Resume Button  -->
                    <Button
                        Width="120"
                        Height="48"
                        Command="{x:Bind ViewModel.PauseResumeCommand}"
                        Visibility="{x:Bind ViewModel.IsNotBreakState, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Glyph="{x:Bind ViewModel.PauseResumeIcon, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.PauseResumeText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!--  Stop Button  -->
                    <Button
                        Width="120"
                        Height="48"
                        Command="{x:Bind ViewModel.StopCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsNotBreakState, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE71A;" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>

                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</Page>
