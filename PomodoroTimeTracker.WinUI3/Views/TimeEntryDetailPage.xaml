<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PomodoroTimeTracker.WinUI3.Views.TimeEntryDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:PomodoroTimeTracker.WinUI3.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:TimeEntryDetailViewModel}"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,24"/>

        <!-- Loading -->
        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="50"
                      Height="50"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind ViewModel.IsNotLoading, Mode=OneWay}">
            <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                <!-- Description -->
                <TextBox Header="Description"
                         Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="What are you working on?"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="80"/>

                <!-- Project Selection -->
                <ComboBox Header="Project (Optional)"
                          ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                          SelectedValue="{x:Bind ViewModel.SelectedProjectId, Mode=TwoWay}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          PlaceholderText="Select a project"
                          HorizontalAlignment="Stretch"/>

                <!-- Start Date/Time -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <DatePicker Header="Start Date"
                                Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"/>
                    <TimePicker Header="Start Time"
                                Time="{x:Bind ViewModel.StartTime, Mode=TwoWay}"
                                ClockIdentifier="24HourClock"/>
                </StackPanel>

                <!-- End Date/Time -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <DatePicker Header="End Date"
                                Date="{x:Bind ViewModel.EndDateValue, Mode=TwoWay}"/>
                    <TimePicker Header="End Time"
                                Time="{x:Bind ViewModel.EndTimeValue, Mode=TwoWay}"
                                ClockIdentifier="24HourClock"/>
                </StackPanel>

                <!-- Duration Display -->
                <TextBlock Style="{StaticResource BodyTextBlockStyle}">
                    <Run Text="Duration: "/>
                    <Run Text="{x:Bind ViewModel.DurationDisplay, Mode=OneWay}"
                         FontWeight="SemiBold"/>
                </TextBlock>

                <!-- Info Text -->
                <TextBlock Text="Fill in the time entry details and click Save."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button Content="Cancel"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    MinWidth="120"/>
            <Button Content="Save"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="120"/>
        </StackPanel>
    </Grid>
</Page>
