<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PomodoroTimeTracker.WinUI3.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PomodoroTimeTracker.WinUI3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:PomodoroTimeTracker.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
    mc:Ignorable="d">

    <TabView SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}">
        <TabViewItem Header="General">
            <local:GeneralSettingsTab />
        </TabViewItem>
        <TabViewItem Header="Pomodoro Timer">
            <local:PomodoroSettingsTab />
        </TabViewItem>
        <TabViewItem Header="Regular Timer" IsEnabled="False">
            <ScrollViewer>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="Coming soon..." />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Regular timer settings will be available in a future update."
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>
        <TabViewItem Header="Stop Watch" IsEnabled="False">
            <ScrollViewer>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="Coming soon..." />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Stopwatch settings will be available in a future update."
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>
    </TabView>
</Page>
