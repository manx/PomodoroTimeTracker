<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PomodoroTimeTracker.WinUI3.Views.GoalCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20"
            MinWidth="250">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       x:Name="TitleText"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>

            <!-- Progress Ring with Percentage -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,8">
                <ProgressRing x:Name="ProgressRing"
                              IsIndeterminate="False"
                              Width="100"
                              Height="100"
                              Background="{ThemeResource ControlStrongFillColorDisabledBrush}"/>
                <TextBlock x:Name="PercentageText"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Hours Display -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="ActualHoursText"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="/"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ExpectedHoursText"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="hrs"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Difference Display -->
            <Border Grid.Row="3"
                    x:Name="DifferenceBorder"
                    HorizontalAlignment="Center"
                    Padding="12,4"
                    CornerRadius="4">
                <TextBlock x:Name="DifferenceText"
                           Style="{StaticResource CaptionTextBlockStyle}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
