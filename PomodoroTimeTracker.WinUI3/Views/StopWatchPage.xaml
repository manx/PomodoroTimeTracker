<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PomodoroTimeTracker.WinUI3.Views.StopWatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PomodoroTimeTracker.WinUI3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:PomodoroTimeTracker.WinUI3.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:StopWatchViewModel}"
    mc:Ignorable="d">

    <Grid>
        <!--  Setup Screen  -->
        <ScrollViewer Visibility="{x:Bind ViewModel.IsSetupState, Mode=OneWay}">
            <StackPanel
                MaxWidth="600"
                Margin="24"
                HorizontalAlignment="Left"
                Spacing="24">

                <TextBlock
                    FontSize="32"
                    FontWeight="Bold"
                    Text="Stop Watch" />

                <!--  Cycle Warning InfoBar  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ShowCycleWarning, Mode=OneWay}"
                    Message="Starting a stopwatch will reset your Pomodoro cycle progress."
                    Severity="Warning"
                    Title="Active Pomodoro Cycle" />

                <Border
                    Width="400"
                    MinHeight="450"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="20">

                        <!--  Client Selection  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Client" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind ViewModel.Clients, Mode=OneWay}"
                                PlaceholderText="Select a client"
                                SelectedItem="{x:Bind ViewModel.SelectedClient, Mode=TwoWay}" />
                        </StackPanel>

                        <!--  Project Selection  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Project" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Name"
                                IsEnabled="{x:Bind ViewModel.IsClientSelected, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                                PlaceholderText="Select a project"
                                SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}" />
                        </StackPanel>

                        <!--  Description  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Description" />
                            <TextBox
                                Height="80"
                                AcceptsReturn="True"
                                MaxLength="{x:Bind viewmodels:StopWatchViewModel.DescriptionMaxLength}"
                                PlaceholderText="What are you working on?"
                                Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Height="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.DescriptionCharacterCount, Mode=OneWay}"
                                TextAlignment="Right" />
                        </StackPanel>

                        <!--  Start Button  -->
                        <Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.StartTimerCommand}"
                            Content="Start Stop Watch"
                            Style="{StaticResource AccentButtonStyle}" />

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  Running Timer Screen  -->
        <Grid Visibility="{x:Bind ViewModel.IsTimerActive, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Container for all timer components - aligned to left with consistent margin  -->
            <StackPanel
                Grid.Row="0"
                Width="360"
                Margin="4,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Spacing="-10">

                <!--  Session Type - centered within container  -->
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="Stop Watch"
                    TextAlignment="Center" />

                <!--  Timer Display (no progress meter for stopwatch)  -->
                <Grid x:Name="TimerGrid" Width="360" Height="400">
                    <!--  Timer and Description centered  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                        <!--  Timer Display  -->
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="72"
                            FontWeight="Bold"
                            Text="{x:Bind ViewModel.TimerDisplay, Mode=OneWay}"
                            TextAlignment="Center" />

                        <!--  Description Display  -->
                        <TextBlock
                            MaxWidth="300"
                            FontSize="14"
                            Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!--  Control Buttons Container - same width and alignment as timer components  -->
            <Grid
                Grid.Row="1"
                Width="360"
                Margin="4,-10,0,24"
                HorizontalAlignment="Left">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="32">

                    <!--  Pause/Resume Button  -->
                    <Button
                        Width="120"
                        Height="48"
                        Command="{x:Bind ViewModel.PauseResumeCommand}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Glyph="{x:Bind ViewModel.PauseResumeIcon, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.PauseResumeText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!--  Stop Button  -->
                    <Button
                        Width="120"
                        Height="48"
                        Command="{x:Bind ViewModel.StopCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE71A;" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>

                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</Page>
