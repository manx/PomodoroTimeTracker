<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PomodoroTimeTracker.WinUI3.Views.ProjectDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:viewmodels="using:PomodoroTimeTracker.ViewModels" 
    d:DataContext="{d:DesignInstance Type=viewmodels:ProjectDetailViewModel}"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,24"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                <!-- Project Name Field -->
                <TextBox Header="Project Name"
                         Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Enter project name"/>

                <!-- Client Selection -->
                <ComboBox Header="Client (Optional)"
                          ItemsSource="{x:Bind ViewModel.Clients, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedClient, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          PlaceholderText="Select a client"
                          HorizontalAlignment="Stretch"/>

                <!-- Description Field -->
                <TextBox Header="Description (Optional)"
                         Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Enter project description"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="120"/>

                <!-- Info Text -->
                <TextBlock Text="Fill in the project details and click Save to continue."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>

                <!-- Work Schedule Section (only visible in edit mode) -->
                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                            Margin="0,16,0,0">
                    <!-- Enable Toggle -->
                    <ToggleSwitch Header="Work Schedule"
                                  IsOn="{x:Bind ViewModel.IsWorkScheduleEnabled, Mode=TwoWay}"
                                  OffContent="Disabled"
                                  OnContent="Enabled"/>

                    <!-- Configuration (visible when enabled) -->
                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.IsWorkScheduleEnabled, Mode=OneWay}"
                                Padding="0,0,0,0">
                        <!-- Base Hours Per Day -->
                        <NumberBox Header="Hours/Day (average)"
                                   Value="{x:Bind ViewModel.BaseHoursPerDay, Mode=TwoWay}"
                                   Minimum="0.5"
                                   Maximum="24"
                                   SmallChange="0.5"
                                   SpinButtonPlacementMode="Compact"/>

                        <!-- Work Days -->
                        <TextBlock Text="Work Days"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,8,0,4"/>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="Mon" IsChecked="{x:Bind ViewModel.WorkOnMonday, Mode=TwoWay}"/>
                                <CheckBox Content="Tue" IsChecked="{x:Bind ViewModel.WorkOnTuesday, Mode=TwoWay}"/>
                                <CheckBox Content="Wed" IsChecked="{x:Bind ViewModel.WorkOnWednesday, Mode=TwoWay}"/>
                                <CheckBox Content="Thu" IsChecked="{x:Bind ViewModel.WorkOnThursday, Mode=TwoWay}"/>
                                <CheckBox Content="Fri" IsChecked="{x:Bind ViewModel.WorkOnFriday, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="Sat" IsChecked="{x:Bind ViewModel.WorkOnSaturday, Mode=TwoWay}"/>
                                <CheckBox Content="Sun" IsChecked="{x:Bind ViewModel.WorkOnSunday, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Public Holidays -->
                        <CheckBox Content="Exclude public holidays"
                                  IsChecked="{x:Bind ViewModel.ExcludePublicHolidays, Mode=TwoWay}"/>

                        <!-- Country Selection (only visible when excluding holidays) -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.ExcludePublicHolidays, Mode=OneWay}">
                            <ComboBox Header="Holiday Country"
                                      ItemsSource="{x:Bind ViewModel.Countries, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedCountry, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      PlaceholderText="Select country"
                                      Width="200"/>
                            <Button Content="Fetch Holidays"
                                    Command="{x:Bind ViewModel.FetchHolidaysCommand}"
                                    VerticalAlignment="Bottom"/>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsFetchingHolidays, Mode=OneWay}"
                                          Width="20" Height="20"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,6"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <!-- Cancel Button -->
            <Button Content="Cancel"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    MinWidth="120"/>

            <!-- Save Button -->
            <Button Content="Save"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="120"/>
        </StackPanel>
    </Grid>
</Page>
