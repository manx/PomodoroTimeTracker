<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PomodoroTimeTracker.WinUI3.Views.ProjectDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:viewmodels="using:PomodoroTimeTracker.WinUI3.ViewModels" 
    d:DataContext="{d:DesignInstance Type=viewmodels:ProjectDetailViewModel}"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,24"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                <!-- Project Name Field -->
                <TextBox Header="Project Name"
                         Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Enter project name"/>

                <!-- Client Selection -->
                <ComboBox Header="Client (Optional)"
                          ItemsSource="{x:Bind ViewModel.Clients, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedClient, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          PlaceholderText="Select a client"
                          HorizontalAlignment="Stretch"/>

                <!-- Description Field -->
                <TextBox Header="Description (Optional)"
                         Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Enter project description"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="120"/>

                <!-- Info Text -->
                <TextBlock Text="Fill in the project details and click Save to continue."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <!-- Cancel Button -->
            <Button Content="Cancel"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    MinWidth="120"/>

            <!-- Save Button -->
            <Button Content="Save"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="120"/>
        </StackPanel>
    </Grid>
</Page>
