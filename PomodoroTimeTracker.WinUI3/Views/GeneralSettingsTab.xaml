<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PomodoroTimeTracker.WinUI3.Views.GeneralSettingsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PomodoroTimeTracker.WinUI3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:PomodoroTimeTracker.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:GeneralSettingsViewModel}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="600"
            Margin="24"
            Spacing="16">

            <TextBlock
                FontSize="28"
                FontWeight="Bold"
                Text="General Settings" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Configure application-wide preferences"
                TextWrapping="Wrap" />

            <!--  Localization Settings  -->
            <TextBlock
                Margin="0,16,0,0"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Localization" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="16">

                    <!--  Language Selection  -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Language" />
                        <ComboBox
                            MinWidth="200"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.AvailableLanguages, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Choose the display language for the application"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Date Format Selection  -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Date Format" />
                        <ComboBox
                            MinWidth="200"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.AvailableDateFormats, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.SelectedDateFormat, Mode=TwoWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Choose how dates are displayed throughout the application"
                            TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!--  Week Settings  -->
            <TextBlock
                Margin="0,16,0,0"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Week Settings" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="16">

                    <!--  Week Start Day  -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Week Start Day" />
                        <ComboBox
                            MinWidth="200"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.AvailableWeekStartDays, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.SelectedWeekStartDay, Mode=TwoWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Choose the first day of the week for reports and calendars"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Week/Year Numbering Standard  -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Week/Year Numbering Standard" />
                        <ComboBox
                            MinWidth="200"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.AvailableWeekYearStandards, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.SelectedWeekYearStandard, Mode=TwoWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Choose the standard for week and year numbering in reports"
                            TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!--  Action Buttons  -->
            <StackPanel
                Margin="0,8,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="Save Settings"
                    IsEnabled="{x:Bind ViewModel.IsNotSaving, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Command="{x:Bind ViewModel.ResetToDefaultsCommand}"
                    Content="Reset to Defaults" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
