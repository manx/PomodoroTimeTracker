{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "format-code",
         "command": "dotnet",
         "args": [ "format", "PomodoroTimeTracker.sln", "--no-restore", "--verbosity", "minimal" ],
         "output": "always",
         "group": "pre-commit"
      },
      {
         "name": "run-tests",
         "command": "dotnet",
         "args": [ "test", "PomodoroTimeTracker.sln", "--no-build", "--verbosity", "quiet", "--nologo" ],
         "output": "always",
         "group": "pre-commit"
      },
      {
         "name": "stage-all-changes",
         "command": "git",
         "args": [ "add", "-u" ],
         "group": "pre-commit"
      }
   ]
}
